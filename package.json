{
  "name": "@uranotools/mcpguard",
  "version": "0.1.0",
  "description": "Interactive MCP CLI/TUI with sectioned form wizards, inline AI flag streaming, multi-provider registry, OAuth browser install, and a VirusTotal-style MCP security shield.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcpguard": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "publish:npm": "npm publish --access public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cli",
    "tui",
    "security",
    "mcp-scanner",
    "tool-poisoning",
    "rug-pull",
    "ai",
    "oauth",
    "urano"
  ],
  "author": "Urano Open Source",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md",
    "DEV_README.md",
    "TESTING.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js",
      "default": "./dist/adapters/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js",
      "default": "./dist/providers/index.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "import": "./dist/security/index.js",
      "default": "./dist/security/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "default": "./dist/auth/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "default": "./dist/ui/index.js"
    }
  },
  "optionalDependencies": {
    "@uranotools/urano-guard": ">=1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uranotools/mcpguard.git"
  },
  "bugs": {
    "url": "https://github.com/uranotools/mcpguard/issues"
  },
  "homepage": "https://github.com/uranotools/mcpguard#readme"
}
